<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 项目特定的排除规则 -->

    <!-- 排除测试类中的某些检查 -->
    <Match>
        <Class name="~.*Test.*" />
        <Bug pattern="DM_DEFAULT_ENCODING" />
    </Match>

    <!-- 排除自动生成的代码 -->
    <Match>
        <Class name="~.*Generated.*" />
    </Match>

    <!-- 排除特定的低优先级问题 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        <Priority value="3" />
    </Match>

    <!-- 排除序列化相关的警告 -->
    <Match>
        <Bug pattern="SE_BAD_FIELD,SE_TRANSIENT_FIELD_NOT_RESTORED" />
    </Match>
</FindBugsFilter>
